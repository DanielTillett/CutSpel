{
    "manifest_version": 3,
    "name": "CutSpel",
    "short_name": "CutSpel",
    "icons": {  "48": "ON.png",
                "128": "ON.png" },
    "permissions": ["storage"],
    "description": "English spelling reform in your browser!",
    "version": "1.1.0",
    "author": "Daniel Tillett",
    "homepage_url": "http://www.cutspel.com",
    "minimum_chrome_version": "102",
    "background": {
        "service_worker": "background.js"
    },
    "options_page": "options.html",
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "exclude_globs": ["*google.com*"],
            "js": ["context-script.js"],
            "run_at": "document_idle"
        }
    ],
    "action": {
        "default_title": "CutSpel (click to turn on/off)",
        "default_icon": {
            "19": "ON.png",
            "38": "ON.png"
        }
    }
}
