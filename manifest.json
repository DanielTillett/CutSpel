{
    "manifest_version": 3,
    "name": "CutSpel",
    "short_name": "CutSpel",
    "icons": { 	"48": "ON.png",
    			"128": "ON.png" },
    "permissions": ["storage"],
    "description": "English spelling reform in your browser!",
    "version": "1.1.0",
	"author": "Daniel Tillett",
	"homepage_url": "https://www.cutspel.com",
    "background":{
        "service_worker": "background.js"
    },
	"options_page":"options.html",
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "exclude_globs": ["*google.com*"],
            "js": ["context-script.js"]
        }
    ],
    "action": {
        "default_icon": {
            "19": "ON.png",
            "38": "ON.png"
        }
    }
}
